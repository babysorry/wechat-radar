+        let path = std::env::temp_dir().join(format!("wx-scan-regression-{}", std::process::id()));
+        let file = std::fs::OpenOptions::new().create_new(true).read(true).write(true)
+            .open(&path).unwrap();
+        // SAFETY: system page size query has no pointer arguments.
+        let page_size = unsafe { libc::sysconf(libc::_SC_PAGESIZE) } as usize;
+        file.set_len((page_size * 2) as u64).unwrap();
+        // SAFETY: map the valid open file; the mapping is never dereferenced
+        // directly and is released below, even when the backing file shrinks.
+        let mapping = unsafe {
+            libc::mmap(std::ptr::null_mut(), page_size * 2, libc::PROT_READ,
+                libc::MAP_PRIVATE, file.as_raw_fd(), 0)
+        };
+        assert_ne!(mapping, libc::MAP_FAILED);
+        file.set_len(page_size as u64).unwrap();
+        let mut storage = vec![0u8; page_size + 1];
+        // SAFETY: obtain our task port; the bad page is read only by the kernel.
+        let task = unsafe { mach_task_self() };
+        // macOS can either reject a page past EOF or supply a zero-filled page.
+        // Consume every returned byte so a deferred file-page fault is detected.
+        let safe_result = match read_owned_chunk(task, mapping as u64 + page_size as u64,
+            page_size, &mut storage) {
+            None => true,
+            Some(copy) => copy.len() == page_size && copy.iter().all(|byte| *byte == 0),
+        };
+        // SAFETY: this is the exact mapping address and size returned above.
+        unsafe { libc::munmap(mapping, page_size * 2); }
+        drop(file);
+        std::fs::remove_file(path).unwrap();
+        assert!(safe_result, "a file page past EOF must be rejected or safely zero-filled");
+    }
