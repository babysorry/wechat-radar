+/// Copy through the kernel into owned memory. Out-of-line mach_vm_read buffers
+/// can retain a file mapping whose pages later fault with SIGBUS. Different
+/// source/destination page offsets force a byte copy instead of a lazy remap.
+fn read_owned_chunk<'a>(
+    task: mach_port_t,
+    addr: mach_vm_address_t,
+    size: usize,
+    storage: &'a mut [u8],
+) -> Option<&'a [u8]> {
+    if size == 0 || size >= storage.len() {
+        return None;
+    }
+    // SAFETY: querying the system page size has no pointer arguments.
+    let page_size = unsafe { libc::sysconf(libc::_SC_PAGESIZE) };
+    if page_size <= 0 {
+        return None;
+    }
+    let base = storage.as_mut_ptr() as mach_vm_address_t;
+    let offset = usize::from(base % page_size as u64 == addr % page_size as u64);
+    let mut copied: mach_vm_size_t = 0;
+    // SAFETY: storage owns an initialized, writable allocation with at least
+    // size + 1 bytes. The kernel copies at most size bytes into this allocation.
+    let kr = unsafe {
+        mach_vm_read_overwrite(task, addr, size as u64, base + offset as u64, &mut copied)
+    };
+    if kr != KERN_SUCCESS || copied == 0 || copied > size as u64 {
+        return None;
+    }
+    Some(&storage[offset..offset + copied as usize])
+}
